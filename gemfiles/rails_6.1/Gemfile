# frozen_string_literal: true

# The Rails integration against Rails 6.1 (the CI "rails" job runs each
# of these): pinned before the main Gemfile adds its own.
gem "activejob", "~> 6.1.0"
gem "railties", "~> 6.1.0"
# Rails before 7.1 counts on concurrent-ruby to load Logger, which
# concurrent-ruby 1.3.5 stopped doing.
gem "concurrent-ruby", "< 1.3.9"
# Default gems Ruby 3.4 no longer has, which this Rails needs.
%w[base64 bigdecimal mutex_m drb].each { |name| gem name }

eval_gemfile "../../Gemfile"
