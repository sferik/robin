exports[`SetPage > explains empty sets and empty searches 1`] = `
<section
  class="panel"
>
  <div
    class="empty"
  >
    <svg
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="miter"
      stroke-width="1.6"
      viewBox="0 0 20 20"
    >
      <path
        d="M4 10.5 L8 14.5 L16 5.5"
      />
    </svg>
    <h3>
      No dead jobs
    </h3>
    <p>
      Jobs that run out of retries land here so you can inspect and replay them.
    </p>
  </div>
</section>
`;

