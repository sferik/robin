        class="stack mt"
      >
        <div
          class="error-box"
        >
          <span
            class="err"
          >
            Net::ReadTimeout
          </span>
          <span
            class="err-msg"
          >
            xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
          </span>
        </div>
        <div>
          <h2>
            Backtrace
          </h2>
          <pre
            class="code"
          >
            <div
              class="bt-app"
            >
              app/a.rb:1
            </div>
          </pre>
        </div>
      </section>
      <section
        class="mt"
      >
        <h2>
          Payload
        </h2>
        <pre
          class="code"
        >
          {

          
            
          <span
            class="json-key"
          >
            "class"
          </span>
          : 
          <span
            class="json-str"
          >
            "HardJob"
          </span>
          

          
          }
        </pre>
      </section>
    </div>
    <section
      class="panel panel-pad"
      style="align-self: start;"
    >
      <h2>
        Details
      </h2>
      <dl
        class="kv"
      >
        <dt>
          Job
        </dt>
        <dd>
          <span
            class="cls"
          >
            <a
              href="/robin/metrics/jobs/HardJob"
            >
              HardJob
            </a>
          </span>
        </dd>
        <dt>
          Job ID
        </dt>
        <dd>
          <button
            class="jid"
            title="Copy job ID"
            type="button"
          >
            j3
          </button>
        </dd>
        <dt>
          Queue
        </dt>
        <dd>
          <a
            href="/robin/queues/default"
          >
            default
          </a>
        </dd>
        <dt>
          Where it is
        </dt>
        <dd>
          Retries
        </dd>
        <dt>
          Next retry
        </dt>
        <dd>
          <time
            datetime="2026-10-14T09:33:00.000Z"
            title="2026-10-14 09:33:00"
          >
            in 3 minutes
          </time>
        </dd>
        <dt>
          Created
        </dt>
        <dd>
          <time
            datetime="2026-10-14T09:29:00.000Z"
            title="2026-10-14 09:29:00"
          >
            1 minute ago
          </time>
        </dd>
        <dt>
          Enqueued
        </dt>
        <dd>
          <time
            datetime="2026-10-14T09:29:30.000Z"
            title="2026-10-14 09:29:30"
          >
            30 seconds ago
          </time>
        </dd>
        <dt>
          Failures
        </dt>
        <dd
          class="num"
        >
          3
        </dd>
        <dt>
          First failed
        </dt>
        <dd>
          <time
            datetime="2026-10-14T08:30:00.000Z"
            title="2026-10-14 08:30:00"
          >
            1 hour ago
          </time>
        </dd>
      </dl>
    </section>
  </div>
</div>
