exports[`SetPage > lists retries with their errors 1`] = `
<div>
  <div
    class="page-head"
  >
    <div>
      <h1>
        Retries
      </h1>
      <p
        class="subtitle"
      >
        2 jobs.
      </p>
    </div>
    <span
      class="spacer"
    />
    <form
      class="search"
      role="search"
    >
      <svg
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="miter"
        stroke-width="1.6"
        viewBox="0 0 20 20"
      >
        <path
          d="M8.5 4 A4.5 4.5 0 1 0 8.51 4 M12 12 L16 16"
        />
      </svg>
      <input
        aria-label="Search class, args, error…"
        class="input"
        placeholder="Search class, args, error…"
        type="search"
      />
    </form>
  </div>
  <section
    class="panel"
  >
    <div
      class="bulkbar"
    >
      <span
        class="sel"
      >
        Select jobs, or act on the whole set
      </span>
      <span
        class="spacer"
      />
      <button
        class="btn btn-small"
      >
        Retry all
      </button>
      <button
        class="btn btn-small"
      >
        Kill all
      </button>
      <button
        class="btn btn-small btn-danger"
      >
        Delete all
      </button>
    </div>
    <div
      class="table-wrap"
    >
      <table
        class="table"
      >
        <thead>
          <tr>
            <th
              class="check"
            >
              <input
                aria-label="Select all on this page"
                type="checkbox"
              />
            </th>
            <th>
              Next retry
            </th>
            <th>
              Job
            </th>
            <th>
              Arguments
            </th>
            <th>
              Error
            </th>
            <th
              class="r"
            >
              Failures
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td
              class="check"
            >
              <input
                aria-label="Select j1"
                type="checkbox"
              />
            </td>
            <td>
              <a
                href="/robin/sets/retries/100-j1"
              >
                <time
                  datetime="2026-10-14T09:31:00.000Z"
                  title="2026-10-14 09:31:00"
                >
                  in 1 minute
                </time>
              </a>
            </td>
            <td>
              <span
                class="cls"
              >
                <a
                  href="/robin/metrics/jobs/HardJob"
                >
                  HardJob
                </a>
              </span>
               
              <div>
                <button
                  class="jid"
                  title="Copy job ID"
                  type="button"
                >
                  j1
                </button>
                 
                <span
                  class="dim small"
                >
                  default
                </span>
              </div>
            </td>
            <td
              class="args"
            >
              1, "two"
            </td>
            <td>
              <a
                class="err"
                href="/robin/sets/retries/100-j1"
              >
                Net::ReadTimeout
              </a>
              <div
                class="err-msg"
              >
                xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
              </div>
            </td>
            <td
              class="r"
            >
              1
            </td>
          </tr>
          <tr>
            <td
              class="check"
            >
              <input
                aria-label="Select j2"
                type="checkbox"
              />
            </td>
            <td>
              <a
                href="/robin/sets/retries/200-j2"
              >
                <time
                  datetime="2026-10-14T09:32:00.000Z"
                  title="2026-10-14 09:32:00"
                >
                  in 2 minutes
                </time>
              </a>
            </td>
            <td>
              <span
                class="cls"
              >
                <a
                  href="/robin/metrics/jobs/HardJob"
                >
                  HardJob
                </a>
              </span>
               
              <span
                class="tag"
              >
                t
              </span>
              <div>
                <button
                  class="jid"
                  title="Copy job ID"
                  type="button"
                >
                  j2
                </button>
                 
                <span
                  class="dim small"
                >
                  default
                </span>
              </div>
            </td>
            <td
              class="args"
            >
              <span
                class="badge"
              >
                Encrypted
              </span>
            </td>
            <td>
              <a
                class="err"
                href="/robin/sets/retries/200-j2"
              >
                Net::ReadTimeout
              </a>
              <div
                class="err-msg"
              >
                
              </div>
            </td>
            <td
              class="r"
            >
              0
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>
`;

