// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Busy > explains idle clusters 1`] = `
<div>
  <div
    class="page-head"
  >
    <div>
      <h1>
        Busy
      </h1>
      <p
        class="subtitle"
      >
        0 processes running 0 of 0 threads.
      </p>
    </div>
    <span
      class="spacer"
    />
    <div
      aria-label="Show"
      class="seg"
      role="group"
    >
      <button
        aria-pressed="true"
      >
        All
      </button>
      <button
        aria-pressed="false"
      >
        Processes
      </button>
      <button
        aria-pressed="false"
      >
        Running jobs
      </button>
    </div>
  </div>
  <section
    class="panel mb"
  >
    <div
      class="panel-head"
    >
      <h2>
        Processes
      </h2>
    </div>
    <div
      class="empty"
    >
      <svg
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="miter"
        stroke-width="1.6"
        viewBox="0 0 20 20"
      >
        <path
          d="M3 10 H6 L8 5 L12 15 L14 10 H17"
        />
      </svg>
      <h3>
        No processes are running
      </h3>
      <p>
        Start one with 
        <code>
          bundle exec robin
        </code>
         and it shows up here within a few seconds.
      </p>
    </div>
  </section>
  <section
    class="panel"
  >
    <div
      class="panel-head"
    >
      <h2>
        Running jobs
      </h2>
    </div>
    <div
      class="empty"
    >
      <svg
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="miter"
        stroke-width="1.6"
        viewBox="0 0 20 20"
      >
        <path
          d="M4 10.5 L8 14.5 L16 5.5"
        />
      </svg>
      <h3>
        All threads are idle
      </h3>
      <p>
        Jobs appear here while they run, with live progress if they report it.
      </p>
    </div>
  </section>
</div>
`;

