exports[`Limiters > explains missing support and empty lists 1`] = `
<div
  class="empty"
>
  <svg
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="miter"
    stroke-width="1.6"
    viewBox="0 0 20 20"
  >
    <path
      d="M3.5 13 A6.5 6.5 0 0 1 16.5 13 M10 13 L13.5 8.5"
    />
  </svg>
  <h3>
    No rate limiters yet
  </h3>
  <p>
    They appear here the first time a job calls one, e.g. Robin::Limiter.concurrent("stripe", 10).
  </p>
</div>
`;

