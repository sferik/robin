exports[`Cron > explains missing support, empty lists, loading and errors 1`] = `
<div
  class="empty"
>
  <svg
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="miter"
    stroke-width="1.6"
    viewBox="0 0 20 20"
  >
    <path
      d="M4 6 H16 V16 H4 Z M4 9 H16 M7 4 V7 M13 4 V7 M8 12.5 L9.5 14 L12.5 11"
    />
  </svg>
  <h3>
    No cron jobs registered
  </h3>
  <p>
    Register them inside 
    <code>
      configure_server
    </code>
     with 
    <code>
      config.periodic { |cron| cron.register "0 * * * *", "HourlyJob" }
    </code>
    .
  </p>
</div>
`;

exports[`Cron > lists periodic jobs and the leader 1`] = `
