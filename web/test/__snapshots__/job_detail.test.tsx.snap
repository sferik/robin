// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EditArgs > starts from the current arguments 1`] = `
<div>
  <div
    class="panel panel-pad mt"
  >
    <h2>
      Edit arguments and retry
    </h2>
    <p
      class="subtitle mb"
    >
      The job is removed from this set and pushed again with a new job ID and a clean failure count.
    </p>
    <textarea
      aria-label="Job arguments as JSON"
      class="input"
    />
    <div
      class="btn-group mt"
    >
      <button
        class="btn btn-primary"
      >
        Retry with these arguments
      </button>
      <button
        class="btn"
      >
        Cancel
      </button>
    </div>
  </div>
</div>
`;

exports[`JobError > shows the error and backtrace 1`] = `
<div>
  <section
    class="stack mt"
  >
    <div
      class="error-box"
    >
      <span
        class="err"
      >
        Boom
      </span>
      <span
        class="err-msg"
      >
        It broke
      </span>
    </div>
    <div>
      <h2>
        Backtrace
      </h2>
      <pre
        class="code"
      >
        <div
          class="bt-app"
        >
          app/x.rb:1
        </div>
        <div
          class="bt-lib"
        >
          /gems/y.rb:2
        </div>
      </pre>
    </div>
  </section>
</div>
`;

exports[`JobFacts > lists everything a failed job in a batch has 1`] = `
