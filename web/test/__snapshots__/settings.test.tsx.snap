exports[`NotFound > links home 1`] = `
<div>
  <section
    class="panel"
  >
    <div
      class="empty"
    >
      <svg
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="miter"
        stroke-width="1.6"
        viewBox="0 0 20 20"
      >
        <path
          d="M8.5 4 A4.5 4.5 0 1 0 8.51 4 M12 12 L16 16"
        />
      </svg>
      <h3>
        There's nothing at this address
      </h3>
      <p>
        The page may have moved. 
        <a
          href="/robin/"
        >
          Go to the dashboard
        </a>
        .
      </p>
    </div>
  </section>
</div>
`;

