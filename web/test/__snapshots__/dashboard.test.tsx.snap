// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Dashboard > explains when no processes are running 1`] = `
<p
  aria-live="polite"
  class="status-line"
>
  No Robin processes are running.
   
  <a
    href="/robin/queues"
  >
    <b>
      1 job
    </b>
  </a>
   is waiting for one to start.
  <span
    class="calm"
  >
    Nothing is waiting to retry.
  </span>
</p>
`;

