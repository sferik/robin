// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Metrics > explains quiet windows 1`] = `
<div
  class="grid-3-1"
>
  <section
    class="panel"
  >
    <div
      class="panel-head"
    >
      <h2>
        Jobs
      </h2>
      <span
        class="spacer"
      />
      <input
        aria-label="Filter by class"
        class="input"
        placeholder="Filter by class"
        type="search"
      />
    </div>
    <div
      class="mt"
    />
    <div
      class="empty"
    >
      <svg
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="miter"
        stroke-width="1.6"
        viewBox="0 0 20 20"
      >
        <path
          d="M4 16 V9 M8 16 V5 M12 16 V11 M16 16 V7"
        />
      </svg>
      <h3>
        No jobs ran in this window
      </h3>
      <p>
        Metrics are flushed by each process every few seconds.
      </p>
    </div>
  </section>
  <section
    class="panel"
  >
    <div
      class="panel-head"
    >
      <h2>
        Queue sizes
      </h2>
    </div>
    <div
      class="panel-pad"
    >
      <div
        class="chart-empty"
        style="height: 180px;"
      >
        Queue sizes are sampled once a minute by the leader process.
      </div>
    </div>
  </section>
</div>
`;

