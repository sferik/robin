// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`QueueDetail > shows a page of jobs 1`] = `
<div>
  <div
    class="page-head"
  >
    <div>
      <div
        class="crumb"
      >
        <a
          href="/robin/queues"
        >
          Queues
        </a>
      </div>
      <h1>
        default
      </h1>
      <p
        class="subtitle"
      >
        3
         jobs waiting. Oldest has waited 
        <span
          class="lat-warn"
          title="Jobs are waiting more than 30 seconds"
        >
          45 s slow
        </span>
        .
         
      </p>
    </div>
    <span
      class="spacer"
    />
    <div
      class="btn-group"
    >
      <button
        class="btn"
      >
        Pause queue
      </button>
      <button
        class="btn btn-danger"
      >
        Clear queue
      </button>
    </div>
  </div>
  <section
    class="panel"
  >
    <div
      class="bulkbar"
    >
      <span
        class="sel"
      >
        Select jobs to act on them
      </span>
      <span
        class="spacer"
      />
      <button
        class="btn btn-small btn-danger"
        disabled=""
      >
        Delete
      </button>
    </div>
    <div
      class="table-wrap"
    >
      <table
        class="table"
      >
        <thead>
          <tr>
            <th
              class="check"
            >
              <input
                aria-label="Select all on this page"
                type="checkbox"
              />
            </th>
            <th>
              Job
            </th>
            <th>
              Arguments
            </th>
            <th>
              Enqueued
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td
              class="check"
            >
              <input
                aria-label="Select a1"
                type="checkbox"
              />
            </td>
            <td>
              <span
                class="cls"
              >
                <a
                  href="/robin/metrics/jobs/HardJob"
                >
                  HardJob
                </a>
              </span>
               
              <span
                class="tag"
              >
                x
              </span>
              <div>
                <button
                  class="jid"
                  title="Copy job ID"
                  type="button"
                >
                  a1
                </button>
              </div>
            </td>
            <td
              class="args"
            >
              1, "two"
            </td>
            <td>
              <time
                datetime="2026-10-14T09:29:30.000Z"
                title="2026-10-14 09:29:30"
              >
                30 seconds ago
              </time>
            </td>
          </tr>
          <tr>
            <td
              class="check"
            >
              <input
                aria-label="Select b2"
                type="checkbox"
              />
            </td>
            <td>
              <span
                class="cls"
              >
                <a
                  href="/robin/metrics/jobs/HardJob"
                >
                  HardJob
                </a>
                <span
                  class="dim small"
                  style="font-weight: 400;"
                >
                   
                  via Wrapper
                </span>
              </span>
               
              <div>
                <button
                  class="jid"
                  title="Copy job ID"
                  type="button"
                >
                  b2
                </button>
              </div>
            </td>
            <td
              class="args"
            >
              <span
                class="badge"
              >
                Encrypted
              </span>
            </td>
            <td>
              <time
                datetime="2026-10-14T07:30:00.000Z"
                title="2026-10-14 07:30:00"
              >
                2 hours ago
              </time>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <nav
      aria-label="Pagination"
      class="pager"
    >
      <span
        class="num"
      >
        1–2 of 3
      </span>
      <span
        class="spacer"
      />
      <button
        class="btn btn-small"
        disabled=""
      >
        Previous
      </button>
      <span
        class="num"
      >
        Page 1 of 2
      </span>
      <button
        class="btn btn-small"
      >
        Next
      </button>
    </nav>
  </section>
</div>
`;

exports[`QueueDetail > shows empty, loading and error states 1`] = `
<section
  class="panel"
>
  <div
    class="empty"
  >
    <svg
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="miter"
      stroke-width="1.6"
      viewBox="0 0 20 20"
    >
      <path
        d="M4 10.5 L8 14.5 L16 5.5"
      />
    </svg>
    <h3>
      q is empty
    </h3>
    <p>
      Every job pushed here has been picked up.
    </p>
  </div>
</section>
`;

exports[`QueueList > lists queues with live sizes 1`] = `
