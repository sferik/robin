exports[`QueueList > shows empty, loading and error states 1`] = `
<div>
  <div
    class="page-head"
  >
    <div>
      <h1>
        Queues
      </h1>
      <p
        class="subtitle"
      >
        0 jobs waiting across 0 queues.
      </p>
    </div>
  </div>
  <section
    class="panel"
  >
    <div
