exports[`Toasts > lists current toasts 2`] = `
<div>
  <div
    aria-live="polite"
    class="toasts"
    role="status"
  >
    <div
      class="toast ok"
    >
      <svg
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="miter"
        stroke-width="1.6"
        viewBox="0 0 20 20"
      >
        <path
          d="M4 10.5 L8 14.5 L16 5.5"
        />
      </svg>
      Saved
    </div>
    <div
