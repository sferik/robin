exports[`SearchBox > submits the trimmed query and follows its value 1`] = `
<div>
  <form
    class="search"
    role="search"
  >
    <svg
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="miter"
      stroke-width="1.6"
      viewBox="0 0 20 20"
    >
      <path
        d="M8.5 4 A4.5 4.5 0 1 0 8.51 4 M12 12 L16 16"
      />
    </svg>
    <input
      aria-label="Search jobs"
      class="input"
      placeholder="Search jobs"
      type="search"
    />
  </form>
</div>
`;

