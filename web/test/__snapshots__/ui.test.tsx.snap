// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ConfirmDialog > opens for a request and resolves with the answer 1`] = `
<div>
  <dialog
    aria-labelledby="confirm-title"
    class="confirm"
  />
</div>
`;

exports[`ConfirmDialog > opens for a request and resolves with the answer 2`] = `
<div>
  <dialog
    aria-labelledby="confirm-title"
    class="confirm"
    open=""
  >
    <form
      method="dialog"
    >
      <h3
        id="confirm-title"
      >
        Pause?
      </h3>
      <p>
        It stops.
      </p>
      <div
        class="btn-group"
      >
        <button
          class="btn"
          type="button"
        >
          Cancel
        </button>
        <button
          autofocus="true"
          class="btn btn-primary"
          type="submit"
        >
          Pause
        </button>
      </div>
    </form>
  </dialog>
</div>
`;

exports[`ConfirmDialog > starts on Cancel for dangerous actions, and can be cancelled 1`] = `
<div>
  <dialog
    aria-labelledby="confirm-title"
    class="confirm"
    open=""
  >
    <form
      method="dialog"
    >
      <h3
        id="confirm-title"
      >
        Delete?
      </h3>
      <div
        class="btn-group"
      >
        <button
          autofocus="true"
          class="btn"
          type="button"
        >
          Cancel
        </button>
        <button
          class="btn btn-danger solid"
          type="submit"
        >
          Delete
        </button>
      </div>
    </form>
  </dialog>
</div>
`;

