exports[`BatchDetail > handles a plain batch 1`] = `
<div>
  <div
    class="page-head"
  >
    <div>
      <div
        class="crumb"
      >
        <a
          href="/robin/batches"
        >
          Batches
        </a>
      </div>
      <h1>
        Untitled batch
      </h1>
      <p
        class="subtitle"
      >
        <span
          class="badge "
        >
          Running
        </span>
         
        <span
          class="mono small"
        >
          b-1
        </span>
      </p>
    </div>
    <span
      class="spacer"
    />
    <div
      class="btn-group"
    >
      <button
        class="btn"
      >
        Cancel batch
      </button>
      <button
        class="btn btn-danger"
      >
        Delete
      </button>
    </div>
  </div>
  <section
    class="panel panel-pad mb"
  >
    <div>
      <div
        aria-label="Batch progress"
        aria-valuemax="100"
        aria-valuemin="0"
        aria-valuenow="60"
        class="progress"
        role="progressbar"
      >
        <span
          class="p-ok"
          style="width: 60%;"
        />
      </div>
      <div
        class="progress-label"
      >
        <span>
          60 of 100 done
        </span>
        <span
          class="num"
        >
          40 waiting
        </span>
      </div>
    </div>
  </section>
  <div
    class="grid-3-1"
  >
    <div
      class="stack"
    >
      <section
        class="panel"
      >
        <div
          class="panel-head"
        >
          <h2>
            Failed jobs
          </h2>
        </div>
        <div
          class="empty"
        >
          <svg
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="miter"
            stroke-width="1.6"
            viewBox="0 0 20 20"
          >
            <path
              d="M4 10.5 L8 14.5 L16 5.5"
            />
          </svg>
          <h3>
            No failures
          </h3>
          <p>
            Jobs that fail at least once are listed here until they succeed.
          </p>
        </div>
      </section>
    </div>
    <section
      class="panel panel-pad"
      style="align-self: start;"
    >
      <h2>
        Details
      </h2>
      <dl
        class="kv"
      >
        <dt>
          Jobs
        </dt>
        <dd
          class="num"
        >
          100 jobs
        </dd>
        <dt>
          Pending
        </dt>
        <dd
          class="num"
        >
          40
        </dd>
        <dt>
          Failures
        </dt>
        <dd
          class="num"
        >
          0
        </dd>
        <dt>
          Created
        </dt>
        <dd>
          <time
            datetime="2026-10-14T09:20:00.000Z"
            title="2026-10-14 09:20:00"
          >
            10 minutes ago
          </time>
        </dd>
        <dt>
          Completed
        </dt>
        <dd>
          <span
            class="dim"
          >
            –
          </span>
        </dd>
        <dt>
          Succeeded
        </dt>
        <dd>
          <span
            class="dim"
          >
            –
          </span>
        </dd>
      </dl>
    </section>
  </div>
</div>
`;

