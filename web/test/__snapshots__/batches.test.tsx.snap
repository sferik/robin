                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      <section
        class="panel"
      >
        <div
          class="panel-head"
        >
          <h2>
            Child batches
          </h2>
        </div>
        <div
          class="table-wrap"
        >
          <table
            class="table"
          >
            <tbody>
              <tr>
                <td>
                  <a
                    href="/robin/batches/c-1"
                  >
                    c-1
                  </a>
                </td>
                <td
