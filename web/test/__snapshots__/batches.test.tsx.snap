                  aria-valuemax="100"
                  aria-valuemin="0"
                  aria-valuenow="60"
                  class="progress"
                  role="progressbar"
                >
                  <span
                    class="p-ok"
                    style="width: 60%;"
                  />
                  <span
                    class="p-fail"
                    style="width: 40%;"
                  />
                </div>
                <div
                  class="progress-label"
                >
                  <span>
                    6 of 10 done, 4 failing
                  </span>
                  <span
                    class="num"
                  >
                    
                  </span>
                </div>
              </div>
            </td>
            <td>
              <time
                datetime="2026-10-14T09:20:00.000Z"
                title="2026-10-14 09:20:00"
