exports[`Batches > explains missing support, empty lists, loading and errors 1`] = `
<div
  class="empty"
>
  <svg
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="miter"
    stroke-width="1.6"
    viewBox="0 0 20 20"
  >
    <path
      d="M4 6 L10 3 L16 6 L10 9 Z M4 10 L10 13 L16 10 M4 14 L10 17 L16 14"
    />
  </svg>
  <h3>
    No batches yet
  </h3>
  <p>
    Create one with 
    <code>
      Robin::Batch.new
    </code>
     and push jobs inside 
    <code>
      batch.jobs { … }
    </code>
    .
  </p>
</div>
`;

