// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`JobLookup > says when the job can't be found 1`] = `
<div>
  <div
    class="page-head"
  >
    <div>
      <div
        class="crumb"
      >
        Job lookup
      </div>
      <h1>
        Job not found
      </h1>
      <p
        class="subtitle mono"
      >
        gone
      </p>
    </div>
    <span
      class="spacer"
    />
  </div>
  <section
    class="panel"
  >
    <div
      class="empty"
    >
      <svg
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="miter"
        stroke-width="1.6"
        viewBox="0 0 20 20"
      >
        <path
          d="M8.5 4 A4.5 4.5 0 1 0 8.51 4 M12 12 L16 16"
        />
      </svg>
      <h3>
        No job with that ID right now
      </h3>
      <p>
        It may have finished (finished jobs aren't kept), or it lives in a queue too large to search. Check the ID and try again.
      </p>
    </div>
  </section>
</div>
`;

