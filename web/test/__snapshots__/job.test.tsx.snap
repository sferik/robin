exports[`JobLookup > shows a running job with its progress 1`] = `
<div>
  <div
    class="page-head"
  >
    <div>
      <div
        class="crumb"
      >
        Job lookup
      </div>
      <h1>
        HardJob
      </h1>
      <p
        class="subtitle mono"
      >
        j 1
      </p>
    </div>
    <span
      class="spacer"
    />
    <button
      class="btn"
    >
      Cancel job
    </button>
  </div>
  <p
    class="notice mb"
  >
    Cancellation was requested for this job.
  </p>
  <div
    class="grid-3-1 mb"
  >
    <div>
      <section
        class="panel panel-pad mb"
      >
        <h2>
          Progress
        </h2>
        <div
          aria-valuemax="100"
          aria-valuemin="0"
          aria-valuenow="42"
          class="progress"
          role="progressbar"
        >
          <span
            class="p-ok"
            style="width: 42%;"
          />
        </div>
        <div
          class="progress-label"
        >
          <span>
            Row 42
          </span>
          <span
            class="num"
          >
            42%
          </span>
        </div>
      </section>
    </div>
    <section
      class="panel panel-pad"
      style="align-self: start;"
    >
      <h2>
        Details
      </h2>
      <dl
        class="kv"
      >
        <dt>
          Job
        </dt>
        <dd>
          <span
            class="cls"
          >
            <a
              href="/robin/metrics/jobs/HardJob"
            >
              HardJob
            </a>
          </span>
        </dd>
        <dt>
          Job ID
        </dt>
        <dd>
          <button
            class="jid"
            title="Copy job ID"
            type="button"
          >
            j 1
          </button>
        </dd>
        <dt>
          Queue
        </dt>
        <dd>
          <a
            href="/robin/queues/default"
          >
            default
          </a>
        </dd>
        <dt>
          Where it is
        </dt>
        <dd>
          Running on web-1:9:aa
        </dd>
        <dt>
          Created
        </dt>
        <dd>
          <time
            datetime="2026-10-14T09:29:00.000Z"
            title="2026-10-14 09:29:00"
          >
            1 minute ago
          </time>
        </dd>
        <dt>
          Enqueued
        </dt>
        <dd>
          <time
            datetime="2026-10-14T09:29:30.000Z"
            title="2026-10-14 09:29:30"
          >
            30 seconds ago
          </time>
        </dd>
      </dl>
    </section>
  </div>
</div>
